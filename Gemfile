# 锁定 CocoaPods 版本，与 Podfile.lock 中的 COCOAPODS 一致。
# 不要直接用全局的 pod 命令，请用：npm run pod:install（或 npm run pod -- <子命令>）
source "https://rubygems.org"

gem "cocoapods", "1.16.2"

# 以下依赖固定在仍支持 macOS 自带 Ruby 2.6 的版本（它们的最新版要求 Ruby 2.7/3.x），
# 这样不需要另装 Ruby，新旧 Mac 都能直接用系统 Ruby 运行
gem "activesupport", "~> 6.1.7"
gem "zeitwerk", "~> 2.6.0"
gem "i18n", "1.14.1"
gem "minitest", "5.25.4"
gem "concurrent-ruby", "1.3.4"
gem "ffi", "~> 1.15.5"
gem "public_suffix", "~> 4.0"
